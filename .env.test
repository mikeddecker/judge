MYSQL_DATABASE = judge_test
MYSQL_USERNAME = root
MYSQL_ROOT_PASSWORD = root
MYSQL_LOCAL_PORT = 3377
MYSQL_DOCKER_PORT = 3306
MYSQL_HOST = mysqldb

# The directory where MYSQL backups go
MYSQL_BACKUP = /storage/backups

# The directory where all videos are stored. They can be subcategorized in folders.
STORAGE_DIR_VIDEOS = /storage/videos

# The directory where all the app's generated data will come.
STORAGE_DIR_GENERATED_DATA = /storage/results

# Ports used by the API service
# local port on your machine, docker port inside the container
API_LOCAL_PORT=5566
API_DOCKER_PORT=5566
WEB_LOCAL_PORT=5273
WEB_DOCKER_PORT=5173

# Video data you want to support.
SUPPORTED_VIDEO_FORMATS = ['.mov', '.mp4', '.MP4']
SUPPORTED_IMAGE_FORMATS = ['.jpeg', '.png']

# Computervision service settings
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Flask Configuration (development or production)
SECRET_KEY=your-secret-key-change-in-production

# Session Configuration
SESSION_COOKIE_SECURE=false

# HTTPS Configuration (default: true in production, false in development)
FORCE_HTTPS=true

# Email Configuration (for MFA and Password Reset)
# Using Outlook or similar SMTP service - leave blank to disable email features
SMTP_SERVER=smtp-mail.outlook.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# Authentication Configuration
REQUIRE_MFA=false

PASSWORD_MIN_LENGTH=12

