    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@gregdev/vue3-shortkey": "^4.0.1",
    "@primeuix/themes": "^1.2.5",
    "@primevue/themes": "^4.5.4",
