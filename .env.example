MYSQL_DATABASE = judge_db
MYSQL_USERNAME = root
MYSQL_ROOT_PASSWORD = root
MYSQL_LOCAL_PORT = 3377
MYSQL_DOCKER_PORT = 3306
MYSQL_HOST = mysqldb

# The directory where MYSQL backups go
MYSQL_BACKUP =
# MYSQL_BACKUP = /mnt/judge-drive/Judge/results/backups

# The directory where all videos are stored. They can be subcategorized in folders.
STORAGE_DIR_VIDEOS =
# STORAGE_DIR_VIDEOS = /mnt/judge-drive/Judge/videos

# The directory where all the app's generated data will come.
STORAGE_DIR_GENERATED_DATA =
# STORAGE_DIR_GENERATED_DATA = /mnt/judge-drive/Judge/results

# Ports used by the API service
API_LOCAL_PORT=5555
API_DOCKER_PORT=5555
WEB_LOCAL_PORT=5173
WEB_DOCKER_PORT=5173

# Video data you want to support.
SUPPORTED_VIDEO_FORMATS = ['.mov', '.mp4', '.MP4']
SUPPORTED_IMAGE_FORMATS = ['.jpeg', '.png']

# Computervision service settings
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Flask Configuration (development or production)
SECRET_KEY=your-secret-key-change-in-production

# Email Configuration (for MFA and Password Reset)
# Using Outlook or similar SMTP service - leave blank to disable email features
SMTP_SERVER=smtp-mail.outlook.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# Authentication Configuration (preferred true in prod)
REQUIRE_MFA=false

PASSWORD_MIN_LENGTH=12

# ============================================================
# Multi-Region Disaster Recovery Configuration
# ============================================================

# Regional Deployment (belgium or usa)
REGION=belgium

# MySQL Server ID for dual-primary replication (1 for belgium, 2 for usa)
MYSQL_SERVER_ID=1

# Remote region hosts for bidirectional sync (SSH accessible)
# These must be reachable from both regions to enable cross-region rsync
# 
# Format options:
#   - SSH alias: REGION_<REGION>_HOST=sync-gateway (requires ~/.ssh/config entry)
#   - Full path: REGION_<REGION>_HOST=sync-user@hostname.example.com
#   - IP address: REGION_<REGION>_HOST=sync-user@192.168.1.100
#
# The sync system will try to connect before starting rsync jobs
# Failure to connect results in syncs being queued for retry
#
# Setup:
#   1. Generate SSH keypair on both regions: ssh-keygen -t ed25519 -f ~/.ssh/id_rsync
#   2. Exchange public keys: cat ~/.ssh/id_rsync.pub >> remote-host:~/.ssh/authorized_keys
#   3. Test connectivity: ssh sync-user@remote-host "echo 'OK'"
#   4. Disable password auth if possible: PasswordAuthentication no in sshd_config
#
REGION_USA_HOST=sync-user@usa-gateway.example.com
REGION_BELGIUM_HOST=sync-user@belgium-gateway.example.com

# ============================================================
# Backup & Retention Configuration
# ============================================================

# Soft-delete recovery window in days (videos recoverable for N days after deletion)
DELETE_RECOVERY_DAYS=30

# Enable automatic sync jobs (disable in development, enable in production)
ENABLE_SYNC_JOBS=false

# Time to wait after AI/predict jobs before syncing (in minutes)
# Rationale: Large video files take time to generate, wait before transferring
SYNC_WAIT_MINUTES_FOR_AI_JOBS=5

# Backup rotation schedule (cron-safe values for manual script runs)
# Number of recent backups to always keep
BACKUP_KEEP_RECENT=12

# ============================================================
# Multi-region Replication Configuration
# ============================================================

# Replication user credentials (used by MySQL replication)
# Create with: GRANT REPLICATION SLAVE ON *.* TO 'repl'@'%' IDENTIFIED BY 'password';
REPLICATION_USER=repl
REPLICATION_PASSWORD=replication_password_change_in_prod

# Binary log position tracking (managed automatically, for reference)
# LOG_FILE=mysql-bin.000001
# LOG_POS=154

# ============================================================
# Logging Configuration
# ============================================================

# Log level for structured logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log output directory (structured logs in JSON format)
# Logs organized by service: {LOG_DIR}/api/{region}/{service}-{date}.log
# Example: /data/logs/api/belgium/sync-manager-2026-03-14.log
LOG_DIR=${STORAGE_DIR_GENERATED_DATA}/logs

# Enable correlation IDs for request tracing across services
# Helps troubleshoot multi-region issues
LOG_ENABLE_CORRELATION_ID=true

# Log rotation: keep logs for N days before auto-delete (GDPR compliance)
LOG_RETENTION_DAYS=30

# Enable slow query logging (logs queries >200ms to separate file)
LOG_SLOW_QUERIES=true
LOG_SLOW_QUERY_THRESHOLD_MS=200

